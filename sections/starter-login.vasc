<style>
:where(.starter) {
  --starter-page: min(100% - clamp(2rem, 6vw, 6rem), var(--starter-content-width, 78rem));
  --starter-space: clamp(2rem, 5vw, var(--starter-section-spacing, 5rem));
  --starter-gap: clamp(1rem, 2.4vw, 2rem);
  --starter-radius: var(--starter-corner-radius, 0.25rem);
  --starter-shadow: 0 1rem 3rem color-mix(in srgb, var(--text) 8%, transparent);
  box-sizing: border-box;
  color: var(--text, #111111);
  background: var(--bg, #ffffff);
  font-family: var(--tf-font-body_font, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
  font-size: var(--starter-body-size, 1rem);
  line-height: 1.55;
}
:where(.starter *),
:where(.starter *::before),
:where(.starter *::after) {
  box-sizing: border-box;
}
:where(.starter img) {
  display: block;
  max-width: 100%;
  height: auto;
}
:where(.starter a) {
  color: inherit;
  text-underline-offset: 0.2em;
}
:where(.starter button),
:where(.starter input),
:where(.starter textarea),
:where(.starter select) {
  font: inherit;
}
:where(.starter button),
:where(.starter summary) {
  -webkit-tap-highlight-color: transparent;
}
:where(.starter :focus-visible) {
  outline: 2px solid var(--accent, #111111);
  outline-offset: 3px;
}
:where(.starter [hidden]) {
  display: none !important;
}
.starter-visually-hidden {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

.starter-shell {
  width: var(--starter-page);
  margin-inline: auto;
}
.starter-section {
  padding-block: var(--starter-space);
}
.starter-section--compact {
  padding-block: clamp(2rem, 4vw, 4rem);
}
.starter-section--border {
  border-block-start: 1px solid var(--border, #e5e5e5);
}
.starter-stack {
  display: grid;
  gap: var(--starter-gap);
}
.starter-cluster {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem 1.25rem;
}
.starter-split {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 1.5rem;
}
.starter-grid {
  display: grid;
  grid-template-columns: repeat(var(--starter-columns, 4), minmax(0, 1fr));
  gap: var(--starter-gap);
}
.starter-grid--entities {
  --starter-columns: 3;
}
.starter-copy {
  max-width: 42rem;
}
.starter-richtext {
  max-width: 46rem;
}
.starter-richtext > :first-child {
  margin-block-start: 0;
}
.starter-richtext > :last-child {
  margin-block-end: 0;
}
.starter-richtext img {
  margin-block: 2rem;
}
.starter-eyebrow {
  margin: 0 0 0.75rem;
  color: var(--text-muted, #686868);
  font-size: 0.75rem;
  font-weight: 650;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.starter-heading {
  font-family: var(--tf-font-heading_font, inherit);
  margin: 0;
  font-size: clamp(2rem, 5vw, 4.75rem);
  font-weight: 600;
  letter-spacing: -0.04em;
  line-height: 1.08;
  overflow-wrap: anywhere;
  text-wrap: balance;
}
.starter-heading--medium {
  font-size: clamp(1.75rem, 3.6vw, 3rem);
  line-height: 1.06;
}
.starter-heading--small {
  font-size: clamp(1.25rem, 2vw, 1.6rem);
  line-height: 1.15;
}
.starter-subheading {
  max-width: 42rem;
  margin: 1rem 0 0;
  color: var(--text-muted, #686868);
  font-size: clamp(1rem, 1.5vw, 1.15rem);
}
.starter-muted {
  color: var(--text-muted, #686868);
}
.starter-empty {
  padding: 2rem;
  border: 1px solid var(--border, #e5e5e5);
  text-align: center;
}
.starter-count {
  display: inline-flex;
  min-width: 1.75rem;
  min-height: 1.75rem;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: color-mix(in srgb, var(--text) 7%, var(--bg));
  font-size: 0.75rem;
}

.starter-button {
  display: inline-flex;
  min-height: 3rem;
  align-items: center;
  justify-content: center;
  padding: 0.75rem 1.35rem;
  border: 1px solid var(--btn, #111111);
  border-radius: var(--starter-radius);
  background: var(--btn, #111111);
  color: var(--btn-text, #ffffff);
  font-size: 0.875rem;
  font-weight: 650;
  text-decoration: none;
  cursor: pointer;
}
.starter-button:hover {
  filter: brightness(0.92);
}
.starter-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
.starter-button--secondary {
  border-color: var(--border, #d8d8d8);
  background: transparent;
  color: var(--text, #111111);
}
.starter-button--text {
  min-height: 0;
  padding: 0;
  border: 0;
  background: none;
  color: var(--text, #111111);
  text-decoration: underline;
}
.starter-field {
  display: grid;
  gap: 0.45rem;
}
.starter-label {
  font-size: 0.8125rem;
  font-weight: 600;
}
.starter-input,
.starter-select,
.starter-textarea {
  width: 100%;
  min-height: 3rem;
  padding: 0.75rem 0.875rem;
  border: 1px solid var(--border, #cfcfcf);
  border-radius: var(--starter-radius);
  background: var(--bg, #ffffff);
  color: var(--text, #111111);
}
.starter-textarea {
  min-height: 8rem;
  resize: vertical;
}

.starter-card {
  min-width: 0;
}
.starter-card__link {
  display: block;
  text-decoration: none;
}
.starter-card__media {
  position: relative;
  aspect-ratio: var(--starter-card-ratio, 4 / 5);
  overflow: hidden;
  background: color-mix(in srgb, var(--text) 4%, var(--bg));
}
.starter-card__media img,
.starter-card__media svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.35s ease;
}
.starter-card__link:hover .starter-card__media img {
  transform: scale(1.02);
}
.starter-card__body {
  display: grid;
  gap: 0.25rem;
  padding-block: 0.9rem 0.25rem;
}
.starter-card__title {
  margin: 0;
  font-size: 0.95rem;
  font-weight: 580;
  line-height: 1.35;
}
.starter-card__meta {
  margin: 0;
  color: var(--text-muted, #686868);
  font-size: 0.8125rem;
}
.starter-card__price {
  margin: 0.15rem 0 0;
  font-size: 0.9rem;
}
.starter-card__price del {
  margin-inline-end: 0.4rem;
  color: var(--text-muted, #686868);
}
.starter-pagination {
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  margin-block-start: 3rem;
}

.starter-header {
  position: relative;
  z-index: 30;
  border-block-end: 1px solid var(--border, #e5e5e5);
}
.starter-header--sticky {
  position: sticky;
  inset-block-start: 0;
}
.starter-announcement {
  padding: 0.55rem 1rem;
  background: var(--btn, #111111);
  color: var(--btn-text, #ffffff);
  font-size: 0.75rem;
  text-align: center;
}
.starter-header__row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  min-height: 4.75rem;
  gap: 1rem;
}
.starter-header__brand {
  min-width: 0;
  font-family: var(--tf-font-heading_font, inherit);
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  text-decoration: none;
  overflow-wrap: anywhere;
}
.starter-header__nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(1rem, 2vw, 2rem);
}
.starter-header__nav a,
.starter-header__actions a {
  font-size: 0.875rem;
  text-decoration: none;
}
.starter-header__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 1rem;
}
.starter-header__menu {
  display: none;
}
.starter-header__cart,
.starter-header__menu > summary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.75rem;
  gap: 0.5rem;
}
.starter-header__icon svg,
.starter-header__menu > summary svg {
  width: 1.25rem;
  height: 1.25rem;
}

.starter-footer {
  border-block-start: 1px solid var(--border, #e5e5e5);
}
.starter-footer__main {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(12rem, 0.8fr) minmax(
      16rem,
      1fr
    );
  gap: clamp(2rem, 6vw, 6rem);
  padding-block: clamp(3rem, 7vw, 6rem);
}
.starter-footer__brand {
  margin: 0 0 0.75rem;
  font-size: 1.2rem;
  font-weight: 700;
}
.starter-footer__nav {
  display: grid;
  align-content: start;
  gap: 0.6rem;
}
.starter-footer__nav a {
  width: fit-content;
  font-size: 0.875rem;
  text-decoration: none;
}
.starter-footer__form {
  display: flex;
  align-items: end;
  gap: 0.5rem;
}
.starter-footer__form .starter-field {
  flex: 1;
}
.starter-footer__bottom {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  padding-block: 1.25rem;
  border-block-start: 1px solid var(--border, #e5e5e5);
  font-size: 0.75rem;
  color: var(--text-muted, #686868);
}
.starter-footer__policies {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 0.5rem 1rem;
}

@media (max-width: 900px) {
  .starter-grid {
    --starter-columns: 2 !important;
  }
  .starter-grid--entities {
    --starter-columns: 2 !important;
  }
  .starter-header__row {
    grid-template-columns: 2.75rem minmax(0, 1fr) auto;
    gap: 0.5rem;
  }
  .starter-header__nav {
    display: none;
  }
  .starter-header__actions > a:not(.starter-header__cart) {
    display: none;
  }
  .starter-header__menu {
    display: block;
    position: relative;
  }
  .starter-header__menu > summary {
    list-style: none;
    cursor: pointer;
    font-size: 0.875rem;
  }
  .starter-header__menu > summary::-webkit-details-marker {
    display: none;
  }
  .starter-header__menu nav {
    position: absolute;
    inset-block-start: calc(100% + 1rem);
    inset-inline-start: 0;
    display: grid;
    width: min(18rem, calc(100vw - 2rem));
    gap: 0;
    padding: 0.5rem;
    border: 1px solid var(--border, #e5e5e5);
    background: var(--bg, #ffffff);
    box-shadow: var(--starter-shadow);
  }
  .starter-header__menu nav a {
    padding: 0.75rem;
    text-decoration: none;
  }
  .starter-footer__main {
    grid-template-columns: 1fr 1fr;
  }
  .starter-footer__newsletter {
    grid-column: 1 / -1;
  }
}
@media (max-width: 700px) {
  :where(.starter) {
    --starter-page: min(100% - 1.5rem, var(--starter-content-width, 78rem));
  }
  .starter-section {
    padding-block: clamp(2rem, 10vw, var(--starter-section-spacing, 5rem));
  }
  .starter-grid {
    gap: 1rem 0.75rem;
  }
  .starter-grid--entities {
    --starter-columns: 1 !important;
  }
  .starter-header__actions > a:not(.starter-header__cart) {
    display: none;
  }
  .starter-header__row {
    min-height: 4rem;
  }
  .starter-split {
    align-items: start;
    flex-direction: column;
  }
  .starter-footer__main {
    grid-template-columns: 1fr;
  }
  .starter-footer__newsletter {
    grid-column: auto;
  }
  .starter-footer__form {
    align-items: stretch;
    flex-direction: column;
  }
  .starter-footer__bottom {
    flex-direction: column;
  }
  .starter-footer__policies {
    justify-content: flex-start;
  }
  .starter-hero__grid,
  .starter-image-copy__grid {
    grid-template-columns: 1fr;
    min-height: 0;
  }
  .starter-hero__content {
    padding: 3.5rem 0;
  }
  .starter-hero__media,
  .starter-image-copy__media {
    min-height: min(32rem, 110vw);
  }
  .starter-image-copy__content {
    padding: 3.5rem 0;
  }
  .starter-image-copy--right .starter-image-copy__media {
    order: initial;
  }
}
@media (prefers-reduced-motion: reduce) {
  .starter-card__media img {
    transition: none;
  }
}

.starter-button { border-radius: var(--starter-button-radius, 0.25rem); }
.starter-header__icon { position: relative; display: inline-flex; align-items: center; justify-content: center; flex: 0 0 2.75rem; width: 2.75rem; height: 2.75rem; }
.starter-header__cart .starter-count { position: absolute; inset-block-start: 0; inset-inline-end: -0.3rem; font-size: 0.65rem; min-width: 1.2rem; height: 1.2rem; padding-inline: 0.25rem; }
.starter-header__brand img { width: 100%; height: auto; max-height: 3.5rem; object-fit: contain; object-position: left center; }
.starter-header__menu > summary { width: 2.75rem; list-style: none; cursor: pointer; }
.starter-header__menu > summary::-webkit-details-marker { display: none; }
.starter-header__menu[open] > summary { background: color-mix(in srgb, var(--text) 5%, var(--bg)); }
.starter-header__menu nav { max-height: min(65svh, 36rem); overflow-y: auto; }
.starter-header__menu nav a:focus-visible { outline-offset: -3px; }
.starter-header--brand-center .starter-header__brand { text-align: center; }
.starter-header--brand-center .starter-header__brand img { margin-inline: auto; object-position: center; }
@media (min-width: 901px) {
  .starter-header--drawer .starter-header__row { grid-template-columns: 2.75rem minmax(0, 1fr) auto; }
  .starter-header--drawer .starter-header__menu { display: block; position: relative; }
  .starter-header--drawer .starter-header__nav { display: none; }
  .starter-header--drawer .starter-header__menu nav { position: absolute; inset-block-start: calc(100% + 1rem); inset-inline-start: 0; display: grid; width: 20rem; padding: 0.5rem; border: 1px solid var(--border); background: var(--bg); box-shadow: var(--starter-shadow); }
  .starter-header--drawer .starter-header__menu nav a { padding: 0.75rem; text-decoration: none; }
  .starter-header--inline.starter-header--brand-center .starter-header__brand { grid-column: 2; grid-row: 1; }
  .starter-header--inline.starter-header--brand-center .starter-header__nav { grid-column: 1; grid-row: 1; justify-content: start; }
}


.starter-hero__media,
.starter-image-copy__media { min-width: 0; width: 100%; }

.starter-auth {
  width: min(100% - 2rem, 30rem);
  margin-inline: auto;
  padding-block: clamp(2rem, 7vw, 5rem);
}
.starter-auth__header {
  margin-block-end: 2rem;
}
.starter-auth__eyebrow {
  font-size: 0.875rem;
  font-weight: 600;
  margin-block-end: 1rem;
}
.starter-auth h1 {
  font-size: clamp(1.75rem, 4vw, 2.25rem);
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin-block: 0 0.75rem;
}
.starter-auth__header > p:last-child,
.starter-field-help {
  color: var(--text-muted, #595959);
}
.starter-auth form {
  display: block;
}
.starter-auth label {
  display: block;
  font-size: 0.875rem;
  font-weight: 500;
  margin-block: 1rem 0.5rem;
}
.starter-auth input:not([type="hidden"]):not([type="checkbox"]) {
  display: block;
  width: 100%;
  min-height: 3rem;
  border: 1px solid var(--border, #bdbdbd);
  border-radius: var(--starter-radius);
  background: var(--bg, #fff);
  color: var(--text, #111);
  padding: 0.75rem;
  font: inherit;
  box-sizing: border-box;
}
.starter-auth input[hidden],
.starter-auth [hidden] {
  display: none !important;
}
.starter-primary {
  display: block;
  width: 100%;
  margin-block-start: 1.25rem;
  padding: 0.875rem 1rem;
  min-height: 3rem;
  border: 1px solid var(--btn, #111);
  border-radius: var(--starter-radius);
  background: var(--btn, #111);
  color: var(--btn-text, #fff);
  font: inherit;
  font-weight: 600;
  cursor: pointer;
}
.starter-primary:hover {
  filter: brightness(0.92);
}
.starter-field-help {
  font-size: 0.8125rem;
  line-height: 1.5;
  margin: 0.5rem 0 0;
}
.starter-auth__switcher {
  display: flex;
  padding: 0.25rem;
  border: 1px solid var(--border, #bdbdbd);
  border-radius: var(--starter-radius);
  gap: 0.25rem;
  margin-block-end: 1.25rem;
}
.starter-auth__switcher button {
  flex: 1;
  min-height: 2.5rem;
  border: 0;
  border-radius: var(--starter-radius);
  background: var(--bg, #fff);
  color: var(--text, #111);
  font: inherit;
  cursor: pointer;
}
.starter-auth__switcher button[aria-pressed="true"] {
  background: var(--btn, #111);
  color: var(--btn-text, #fff);
}
.starter-auth__identity {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-block-end: 1.5rem;
  overflow-wrap: anywhere;
}
.starter-auth__identity a,
.starter-auth__back,
.starter-text-button {
  font-size: 0.875rem;
  color: var(--text, #111);
  text-underline-offset: 0.2em;
}
.starter-auth__back {
  display: inline-block;
  margin-block-start: 2rem;
}
.starter-text-button {
  border: 0;
  background: none;
  text-decoration: underline;
  padding: 0.5rem 0;
  cursor: pointer;
  font-family: inherit;
}
.starter-auth__resend {
  margin-block-start: 0.75rem;
}
.starter-form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}
.starter-form-row > * {
  min-width: 0;
}
.starter-auth label.starter-check {
  display: flex;
  align-items: flex-start;
  gap: 0.625rem;
  line-height: 1.5;
  font-weight: 400;
}
.starter-check input {
  appearance: none;
  flex: 0 0 1.25rem;
  width: 1.25rem;
  height: 1.25rem;
  border: 1px solid var(--text-muted, #777);
  border-radius: var(--starter-radius);
  background: var(--bg, #fff);
  padding: 0;
  margin: 0.0625rem 0 0;
  cursor: pointer;
}
.starter-check input:checked {
  background: var(--btn, #111);
  border-color: var(--btn, #111);
}
.starter-check input:checked::after {
  content: "";
  display: block;
  width: 0.3rem;
  height: 0.6rem;
  border: solid var(--btn-text, #fff);
  border-width: 0 2px 2px 0;
  transform: translate(0.4rem, 0.17rem) rotate(45deg);
}
.starter-message {
  padding: 1rem;
  border-inline-start: 2px solid var(--text, #111);
  background: color-mix(in srgb, var(--text) 4%, var(--bg));
  font-size: 0.875rem;
  line-height: 1.5;
  margin-block: 1rem;
}
.starter-message--error {
  font-weight: 500;
}
.starter-phone {
  display: flex;
  position: relative;
  align-items: stretch;
  border: 1px solid var(--border, #bdbdbd);
  border-radius: var(--starter-radius);
}
.starter-auth .starter-phone > input[type="tel"] {
  border: 0;
  min-width: 0;
}
.starter-phone__country {
  flex-shrink: 0;
}
.starter-phone__country summary {
  display: flex;
  list-style: none;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  min-width: 3.25rem;
  height: 100%;
  cursor: pointer;
  border-inline-end: 1px solid var(--border, #ddd);
}
.starter-phone__country summary::-webkit-details-marker {
  display: none;
}
.starter-phone__chevron {
  font-size: 0.8rem;
}
.starter-phone__picker {
  position: absolute;
  z-index: 10;
  inset-inline: 0;
  top: calc(100% + 0.5rem);
  padding: 0.875rem;
  border: 1px solid var(--border, #bdbdbd);
  border-radius: var(--starter-radius);
  background: var(--bg, #fff);
  box-shadow: var(--starter-shadow);
}
.starter-phone__picker > label {
  margin-block-start: 0;
}
.starter-phone__picker ul {
  list-style: none;
  padding: 0;
  margin: 0.75rem -0.375rem -0.375rem;
  max-height: min(15rem, 36dvh);
  overflow-y: auto;
  overscroll-behavior: contain;
}
.starter-phone__picker button {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  width: 100%;
  min-height: 2.75rem;
  padding: 0.625rem 0.375rem;
  border: 0;
  background: var(--bg, #fff);
  color: var(--text, #111);
  text-align: start;
  font: inherit;
  font-size: 0.875rem;
  cursor: pointer;
}
.starter-phone__picker button:hover,
.starter-phone__picker button:focus-visible {
  background: color-mix(in srgb, var(--text) 4%, var(--bg));
}
.starter-phone__dial {
  margin-inline-start: auto;
  color: var(--text-muted, #595959);
  white-space: nowrap;
}
@media (max-width: 360px) {
  .starter-form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }
}

.starter-phone__country[data-side="above"] .starter-phone__picker {
  top: auto;
  bottom: calc(100% + 0.5rem);
}
</style>
<main
  class="starter starter-auth"
  data-preferred-method="{{ auth_form.provider | default: customer_settings.preferred_auth_method }}"
>
  <header class="starter-auth__header">
    <p class="starter-auth__eyebrow">{{ shop.name }}</p>
    <h1>{{ 'login' | t }}</h1>
    <p>{{ 'auth_intro' | t }}</p>
  </header>

  {% if form_error.message %}
    <p class="starter-message starter-message--error" role="alert">{{ form_error.message }}</p>
  {% endif %}
  {% if auth_notice.message %}
    <p class="starter-message" role="status">{{ auth_notice.message }}</p>
  {% endif %}

  {% if customer_settings.accounts_available %}
    {% if auth_form.otp_step == 'verify' %}
      <div class="starter-auth__identity">
        <span>
          {%- if auth_form.provider == 'phone' %}{{ auth_form.phone_number }}{% else %}{{ auth_form.email }}{% endif -%}
        </span>
        <a href="{{ customer_settings.login_url }}">{{ 'change' | t }}</a>
      </div>
      {% if auth_form.purpose == 'register' %}
        {% form 'register' %}
          <input type="hidden" name="provider" value="{{ auth_form.provider }}">
          {% if auth_form.provider == 'phone' %}
            <input type="hidden" name="phone_number" value="{{ auth_form.phone_number }}">
          {% else %}
            <input type="hidden" name="email" value="{{ auth_form.email }}">
          {% endif %}
          <label for="starter-code">{{ 'code' | t }}</label>
          <input
            id="starter-code"
            name="code"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9]{6}"
            minlength="6"
            maxlength="6"
            required
            aria-describedby="starter-code-help"
          >
          <p id="starter-code-help" class="starter-field-help">{{ 'code_help' | t }}</p>
          {% if auth_form.purpose == 'register' %}
            <div class="starter-form-row">
              <div>
                <label for="starter-first-name">{{ 'first_name' | t }}</label
                ><input id="starter-first-name" name="first_name" autocomplete="given-name">
              </div>
              <div>
                <label for="starter-last-name">{{ 'last_name' | t }}</label
                ><input id="starter-last-name" name="last_name" autocomplete="family-name">
              </div>
            </div>
            {% if customer_settings.collect_marketing_consent and auth_form.provider == 'email' %}
              <label class="starter-check"
                ><input type="checkbox" name="accepts_marketing" value="true"
                ><span>{{ 'marketing_consent' | t }}</span></label
              >
            {% endif %}
          {% endif %}
          <button class="starter-primary" type="submit">{{ 'verify_continue' | t }}</button>
        {% endform %}
      {% else %}
        {% form 'login' %}
          <input type="hidden" name="provider" value="{{ auth_form.provider }}">
          {% if auth_form.provider == 'phone' %}
            <input type="hidden" name="phone_number" value="{{ auth_form.phone_number }}">
          {% else %}
            <input type="hidden" name="email" value="{{ auth_form.email }}">
          {% endif %}
          <label for="starter-code">{{ 'code' | t }}</label>
          <input
            id="starter-code"
            name="code"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9]{6}"
            minlength="6"
            maxlength="6"
            required
            aria-describedby="starter-code-help"
          >
          <p id="starter-code-help" class="starter-field-help">{{ 'code_help' | t }}</p>
          {% if auth_form.purpose == 'register' %}
            <div class="starter-form-row">
              <div>
                <label for="starter-first-name">{{ 'first_name' | t }}</label
                ><input id="starter-first-name" name="first_name" autocomplete="given-name">
              </div>
              <div>
                <label for="starter-last-name">{{ 'last_name' | t }}</label
                ><input id="starter-last-name" name="last_name" autocomplete="family-name">
              </div>
            </div>
            {% if customer_settings.collect_marketing_consent and auth_form.provider == 'email' %}
              <label class="starter-check"
                ><input type="checkbox" name="accepts_marketing" value="true"
                ><span>{{ 'marketing_consent' | t }}</span></label
              >
            {% endif %}
          {% endif %}
          <button class="starter-primary" type="submit">{{ 'verify_continue' | t }}</button>
        {% endform %}
      {% endif %}
      <div class="starter-auth__resend">
        {% form 'auth_code_send' %}
          <input type="hidden" name="provider" value="{{ auth_form.provider }}">
          {% if auth_form.provider == 'phone' -%}
            <input type="hidden" name="phone_number" value="{{ auth_form.phone_number }}">
          {%- else -%}
            <input type="hidden" name="email" value="{{ auth_form.email }}">
          {%- endif %}
          <button class="starter-text-button" type="submit">{{ 'resend_code' | t }}</button>
        {% endform %}
      </div>
    {% else %}
      {% if customer_settings.email_login_available and customer_settings.phone_login_available %}
        <div class="starter-auth__switcher" role="group" aria-label="{{ 'sign_in_method' | t }}" hidden>
          <button type="button" data-method="email" aria-pressed="false">{{ 'email' | t }}</button>
          <button type="button" data-method="phone" aria-pressed="false">{{ 'phone' | t }}</button>
        </div>
      {% endif %}
      {% if customer_settings.email_login_available %}
        <div class="starter-auth__method" data-method-panel="email">
          {% form 'auth_code_send' %}
            <input type="hidden" name="provider" value="email">
            <label for="starter-email">{{ 'email' | t }}</label>
            <input
              id="starter-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              value="{{ auth_form.email }}"
              required
              maxlength="254"
              placeholder="{{ 'email_example' | t }}"
            >
            <button class="starter-primary" type="submit">{{ 'send_code' | t }}</button>
          {% endform %}
        </div>
      {% endif %}
      {% if customer_settings.phone_login_available %}
        <div class="starter-auth__method" data-method-panel="phone">
          {% assign country_options = phone_countries | sort: 'name' %}
          {% assign first_country = country_options | first %}
          {% assign default_dial = first_country.dial_code %}
          {% assign default_flag = first_country.flag %}
          {% for country in country_options %}
            {% if country.iso_code == customer_settings.default_phone_country %}
              {% assign default_dial = country.dial_code %}
              {% assign default_flag = country.flag %}
            {% endif %}
          {% endfor %}
          {% form 'auth_code_send' %}
            <input type="hidden" name="provider" value="phone">
            <label for="starter-phone">{{ 'phone' | t }}</label>
            <div class="starter-phone">
              {% if country_options.size > 0 %}
                <details class="starter-phone__country">
                  <summary aria-label="{{ 'choose_country' | t }}" data-label="{{ 'choose_country' | t }}">
                    <span data-country-flag>{{ default_flag }}</span
                    ><span class="starter-phone__chevron" aria-hidden="true">⌄</span>
                  </summary>
                  <div class="starter-phone__picker">
                    <label for="starter-country-search">{{ 'choose_country' | t }}</label>
                    <input
                      id="starter-country-search"
                      type="search"
                      data-country-search
                      placeholder="{{ 'search_countries' | t }}"
                      autocomplete="off"
                    >
                    <ul aria-label="{{ 'countries' | t }}">
                      {% for country in country_options %}
                        <li>
                          <button
                            type="button"
                            data-country="{{ country.iso_code }}"
                            data-dial="{{ country.dial_code }}"
                            data-flag="{{ country.flag }}"
                          >
                            <span aria-hidden="true">{{ country.flag }}</span>
                            <span data-country-name>{{ country.name }}</span>
                            <span class="starter-phone__dial">{{ country.dial_code }}</span>
                          </button>
                        </li>
                      {% endfor %}
                    </ul>
                    <p data-country-empty hidden>{{ 'no_countries' | t }}</p>
                  </div>
                </details>
              {% endif %}
              <input
                id="starter-phone"
                name="phone_number"
                type="tel"
                dir="ltr"
                autocomplete="tel"
                inputmode="tel"
                value="{{ auth_form.phone_number | default: default_dial }}"
                data-current-dial="{{ default_dial }}"
                data-current-country="{{ customer_settings.default_phone_country }}"
                pattern="[+][0-9]{6,15}"
                maxlength="16"
                required
                aria-describedby="starter-phone-help"
              >
            </div>
            <p id="starter-phone-help" class="starter-field-help">{{ 'phone_help' | t }}</p>
            <button class="starter-primary" type="submit">{{ 'send_code' | t }}</button>
          {% endform %}
        </div>
      {% endif %}
      {% unless customer_settings.email_login_available or customer_settings.phone_login_available %}
        <p>{{ 'sign_in_unavailable' | t }}</p>
      {% endunless %}
    {% endif %}
  {% else %}
    <p>{{ 'sign_in_unavailable' | t }}</p>
  {% endif %}
  <a class="starter-auth__back" href="{{ routes.root_url }}">{{ 'back_to_store' | t }}</a>
</main>
<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || !root.classList.contains('starter-auth')) return;
    const switcher = root.querySelector('.starter-auth__switcher');
    const panels = [...root.querySelectorAll('[data-method-panel]')];
    if (switcher) {
      const select = (method) => {
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.methodPanel !== method;
        });
        switcher
          .querySelectorAll('[data-method]')
          .forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.method === method)));
      };
      const preferred = panels.some((panel) => panel.dataset.methodPanel === root.dataset.preferredMethod)
        ? root.dataset.preferredMethod
        : panels[0].dataset.methodPanel;
      select(preferred);
      switcher.hidden = false;
      switcher.addEventListener('click', (event) => {
        const button = event.target.closest('[data-method]');
        if (button) select(button.dataset.method);
      });
    }
    const picker = root.querySelector('.starter-phone__country');
    const phone = root.querySelector('#starter-phone');
    if (picker && phone) {
      const search = picker.querySelector('[data-country-search]');
      const choices = [...picker.querySelectorAll('li')];
      const list = picker.querySelector('ul');
      choices.sort((a, b) =>
        a
          .querySelector('[data-country-name]')
          .textContent.localeCompare(
            b.querySelector('[data-country-name]').textContent,
            document.documentElement.lang || undefined,
          ),
      );
      choices.forEach((item) => list.appendChild(item));
      const dialChoices = choices
        .map((item) => item.querySelector('[data-dial]'))
        .sort((a, b) => b.dataset.dial.length - a.dataset.dial.length);
      const summary = picker.querySelector('summary');
      const matchNumber = () => {
        const value = phone.value.replace(/[\s().-]/g, '');
        const selected = dialChoices.find((button) => button.dataset.country === phone.dataset.currentCountry);
        const longest = dialChoices.find((button) => value.startsWith(button.dataset.dial));
        if (
          selected &&
          value.startsWith(selected.dataset.dial) &&
          (!longest || longest.dataset.dial.length === selected.dataset.dial.length)
        )
          return selected;
        return longest && dialChoices.filter((button) => button.dataset.dial === longest.dataset.dial).length === 1
          ? longest
          : undefined;
      };
      const syncCountry = () => {
        const selected = matchNumber();
        phone.dataset.currentDial = selected?.dataset.dial || '';
        phone.dataset.currentCountry = selected?.dataset.country || '';
        picker.querySelector('[data-country-flag]').textContent = selected?.dataset.flag || '🌐';
        summary.setAttribute(
          'aria-label',
          summary.dataset.label + (selected ? ': ' + selected.querySelector('[data-country-name]').textContent : ''),
        );
      };
      syncCountry();
      phone.addEventListener('input', syncCountry);
      const place = () => {
        const rect = phone.getBoundingClientRect();
        const viewport = window.visualViewport;
        const top = viewport ? viewport.offsetTop : 0;
        const bottom = top + (viewport ? viewport.height : window.innerHeight);
        const below = bottom - rect.bottom - 12;
        const above = rect.top - top - 12;
        const openAbove = below < 240 && above > below;
        picker.dataset.side = openAbove ? 'above' : 'below';
        const panel = picker.querySelector('.starter-phone__picker');
        const chrome = panel.getBoundingClientRect().height - list.getBoundingClientRect().height;
        list.style.maxHeight = Math.max(80, Math.min(240, (openAbove ? above : below) - chrome)) + 'px';
      };
      const filter = () => {
        const query = search.value.trim().toLocaleLowerCase();
        choices.forEach((item) => {
          item.hidden = !item.textContent.toLocaleLowerCase().includes(query);
        });
        picker.querySelector('[data-country-empty]').hidden = choices.some((item) => !item.hidden);
      };
      picker.addEventListener('toggle', () => {
        if (picker.open) {
          filter();
          list.scrollTop = 0;
          place();
          search.focus({ preventScroll: true });
          window.addEventListener('resize', place);
          window.visualViewport?.addEventListener('resize', place);
        } else {
          search.value = '';
          filter();
          window.removeEventListener('resize', place);
          window.visualViewport?.removeEventListener('resize', place);
        }
      });
      picker.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          event.preventDefault();
          picker.open = false;
          picker.querySelector('summary').focus();
        }
        if (event.key === 'Enter' && event.target === search) event.preventDefault();
      });
      search.addEventListener('input', () => {
        filter();
        place();
      });
      picker.addEventListener('click', (event) => {
        const button = event.target.closest('[data-dial]');
        if (!button) return;
        let number = phone.value.replace(/[^+0-9]/g, '');
        const previous = dialChoices.find((choice) => number.startsWith(choice.dataset.dial));
        if (previous) number = number.slice(previous.dataset.dial.length);
        phone.value = button.dataset.dial + number.replace(/[^0-9]/g, '');
        phone.dataset.currentCountry = button.dataset.country;
        syncCountry();
        phone.dispatchEvent(new Event('input', { bubbles: true }));
        picker.open = false;
        phone.focus();
      });
      picker.addEventListener('focusout', (event) => {
        if (event.relatedTarget && !picker.contains(event.relatedTarget)) picker.open = false;
      });
      root.addEventListener('pointerdown', (event) => {
        if (!picker.contains(event.target)) picker.open = false;
      });
    }
  })();
</script>
{% schema %}
{
  "name": "starter-login",
  "kind": "section",
  "ctx_needs": [
    "shop",
    "customer_settings",
    "auth_form",
    "auth_notice",
    "form_error",
    "phone_countries",
    "routes"
  ],
  "settings": []
}
{% endschema %}
