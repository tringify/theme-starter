<style>
:where(.starter) {
  --starter-page: min(100% - clamp(2rem, 6vw, 6rem), var(--starter-content-width, 78rem));
  --starter-space: clamp(2rem, 5vw, var(--starter-section-spacing, 5rem));
  --starter-gap: clamp(1rem, 2.4vw, 2rem);
  --starter-radius: var(--starter-corner-radius, 0.25rem);
  --starter-shadow: 0 1rem 3rem color-mix(in srgb, var(--text) 8%, transparent);
  box-sizing: border-box;
  color: var(--text, #111111);
  background: var(--bg, #ffffff);
  font-family: var(--tf-font-body_font, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif);
  font-size: var(--starter-body-size, 1rem);
  line-height: 1.55;
}
:where(.starter *),
:where(.starter *::before),
:where(.starter *::after) {
  box-sizing: border-box;
}
:where(.starter img) {
  display: block;
  max-width: 100%;
  height: auto;
}
:where(.starter a) {
  color: inherit;
  text-underline-offset: 0.2em;
}
:where(.starter button),
:where(.starter input),
:where(.starter textarea),
:where(.starter select) {
  font: inherit;
}
:where(.starter button),
:where(.starter summary) {
  -webkit-tap-highlight-color: transparent;
}
:where(.starter :focus-visible) {
  outline: 2px solid var(--accent, #111111);
  outline-offset: 3px;
}
:where(.starter [hidden]) {
  display: none !important;
}
.starter-visually-hidden {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
}

.starter-shell {
  width: var(--starter-page);
  margin-inline: auto;
}
.starter-section {
  padding-block: var(--starter-space);
}
.starter-section--compact {
  padding-block: clamp(2rem, 4vw, 4rem);
}
.starter-section--border {
  border-block-start: 1px solid var(--border, #e5e5e5);
}
.starter-stack {
  display: grid;
  gap: var(--starter-gap);
}
.starter-cluster {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem 1.25rem;
}
.starter-split {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 1.5rem;
}
.starter-grid {
  display: grid;
  grid-template-columns: repeat(var(--starter-columns, 4), minmax(0, 1fr));
  gap: var(--starter-gap);
}
.starter-grid--entities {
  --starter-columns: 3;
}
.starter-copy {
  max-width: 42rem;
}
.starter-richtext {
  max-width: 46rem;
}
.starter-richtext > :first-child {
  margin-block-start: 0;
}
.starter-richtext > :last-child {
  margin-block-end: 0;
}
.starter-richtext img {
  margin-block: 2rem;
}
.starter-eyebrow {
  margin: 0 0 0.75rem;
  color: var(--text-muted, #686868);
  font-size: 0.75rem;
  font-weight: 650;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.starter-heading {
  font-family: var(--tf-font-heading_font, inherit);
  margin: 0;
  font-size: clamp(2rem, 5vw, 4.75rem);
  font-weight: 600;
  letter-spacing: -0.04em;
  line-height: 1.08;
  overflow-wrap: anywhere;
  text-wrap: balance;
}
.starter-heading--medium {
  font-size: clamp(1.75rem, 3.6vw, 3rem);
  line-height: 1.06;
}
.starter-heading--small {
  font-size: clamp(1.25rem, 2vw, 1.6rem);
  line-height: 1.15;
}
.starter-subheading {
  max-width: 42rem;
  margin: 1rem 0 0;
  color: var(--text-muted, #686868);
  font-size: clamp(1rem, 1.5vw, 1.15rem);
}
.starter-muted {
  color: var(--text-muted, #686868);
}
.starter-empty {
  padding: 2rem;
  border: 1px solid var(--border, #e5e5e5);
  text-align: center;
}
.starter-count {
  display: inline-flex;
  min-width: 1.75rem;
  min-height: 1.75rem;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: color-mix(in srgb, var(--text) 7%, var(--bg));
  font-size: 0.75rem;
}

.starter-button {
  display: inline-flex;
  min-height: 3rem;
  align-items: center;
  justify-content: center;
  padding: 0.75rem 1.35rem;
  border: 1px solid var(--btn, #111111);
  border-radius: var(--starter-radius);
  background: var(--btn, #111111);
  color: var(--btn-text, #ffffff);
  font-size: 0.875rem;
  font-weight: 650;
  text-decoration: none;
  cursor: pointer;
}
.starter-button:hover {
  filter: brightness(0.92);
}
.starter-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
.starter-button--secondary {
  border-color: var(--border, #d8d8d8);
  background: transparent;
  color: var(--text, #111111);
}
.starter-button--text {
  min-height: 0;
  padding: 0;
  border: 0;
  background: none;
  color: var(--text, #111111);
  text-decoration: underline;
}
.starter-field {
  display: grid;
  gap: 0.45rem;
}
.starter-label {
  font-size: 0.8125rem;
  font-weight: 600;
}
.starter-input,
.starter-select,
.starter-textarea {
  width: 100%;
  min-height: 3rem;
  padding: 0.75rem 0.875rem;
  border: 1px solid var(--border, #cfcfcf);
  border-radius: var(--starter-radius);
  background: var(--bg, #ffffff);
  color: var(--text, #111111);
}
.starter-textarea {
  min-height: 8rem;
  resize: vertical;
}

.starter-card {
  min-width: 0;
}
.starter-card__link {
  display: block;
  text-decoration: none;
}
.starter-card__media {
  position: relative;
  aspect-ratio: var(--starter-card-ratio, 4 / 5);
  overflow: hidden;
  background: color-mix(in srgb, var(--text) 4%, var(--bg));
}
.starter-card__media img,
.starter-card__media svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.35s ease;
}
.starter-card__link:hover .starter-card__media img {
  transform: scale(1.02);
}
.starter-card__body {
  display: grid;
  gap: 0.25rem;
  padding-block: 0.9rem 0.25rem;
}
.starter-card__title {
  margin: 0;
  font-size: 0.95rem;
  font-weight: 580;
  line-height: 1.35;
}
.starter-card__meta {
  margin: 0;
  color: var(--text-muted, #686868);
  font-size: 0.8125rem;
}
.starter-card__price {
  margin: 0.15rem 0 0;
  font-size: 0.9rem;
}
.starter-card__price del {
  margin-inline-end: 0.4rem;
  color: var(--text-muted, #686868);
}
.starter-pagination {
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  margin-block-start: 3rem;
}

.starter-header {
  position: relative;
  z-index: 30;
  border-block-end: 1px solid var(--border, #e5e5e5);
}
.starter-header--sticky {
  position: sticky;
  inset-block-start: 0;
}
.starter-announcement {
  padding: 0.55rem 1rem;
  background: var(--btn, #111111);
  color: var(--btn-text, #ffffff);
  font-size: 0.75rem;
  text-align: center;
}
.starter-header__row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
  align-items: center;
  min-height: 4.75rem;
  gap: 1rem;
}
.starter-header__brand {
  min-width: 0;
  font-family: var(--tf-font-heading_font, inherit);
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  text-decoration: none;
  overflow-wrap: anywhere;
}
.starter-header__nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(1rem, 2vw, 2rem);
}
.starter-header__nav a,
.starter-header__actions a {
  font-size: 0.875rem;
  text-decoration: none;
}
.starter-header__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 1rem;
}
.starter-header__menu {
  display: none;
}
.starter-header__cart,
.starter-header__menu > summary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.75rem;
  gap: 0.5rem;
}
.starter-header__icon svg,
.starter-header__menu > summary svg {
  width: 1.25rem;
  height: 1.25rem;
}

.starter-footer {
  border-block-start: 1px solid var(--border, #e5e5e5);
}
.starter-footer__main {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(12rem, 0.8fr) minmax(
      16rem,
      1fr
    );
  gap: clamp(2rem, 6vw, 6rem);
  padding-block: clamp(3rem, 7vw, 6rem);
}
.starter-footer__brand {
  margin: 0 0 0.75rem;
  font-size: 1.2rem;
  font-weight: 700;
}
.starter-footer__nav {
  display: grid;
  align-content: start;
  gap: 0.6rem;
}
.starter-footer__nav a {
  width: fit-content;
  font-size: 0.875rem;
  text-decoration: none;
}
.starter-footer__form {
  display: flex;
  align-items: end;
  gap: 0.5rem;
}
.starter-footer__form .starter-field {
  flex: 1;
}
.starter-footer__bottom {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  padding-block: 1.25rem;
  border-block-start: 1px solid var(--border, #e5e5e5);
  font-size: 0.75rem;
  color: var(--text-muted, #686868);
}
.starter-footer__policies {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 0.5rem 1rem;
}

@media (max-width: 900px) {
  .starter-grid {
    --starter-columns: 2 !important;
  }
  .starter-grid--entities {
    --starter-columns: 2 !important;
  }
  .starter-header__row {
    grid-template-columns: 2.75rem minmax(0, 1fr) auto;
    gap: 0.5rem;
  }
  .starter-header__nav {
    display: none;
  }
  .starter-header__actions > a:not(.starter-header__cart) {
    display: none;
  }
  .starter-header__menu {
    display: block;
    position: relative;
  }
  .starter-header__menu > summary {
    list-style: none;
    cursor: pointer;
    font-size: 0.875rem;
  }
  .starter-header__menu > summary::-webkit-details-marker {
    display: none;
  }
  .starter-header__menu nav {
    position: absolute;
    inset-block-start: calc(100% + 1rem);
    inset-inline-start: 0;
    display: grid;
    width: min(18rem, calc(100vw - 2rem));
    gap: 0;
    padding: 0.5rem;
    border: 1px solid var(--border, #e5e5e5);
    background: var(--bg, #ffffff);
    box-shadow: var(--starter-shadow);
  }
  .starter-header__menu nav a {
    padding: 0.75rem;
    text-decoration: none;
  }
  .starter-footer__main {
    grid-template-columns: 1fr 1fr;
  }
  .starter-footer__newsletter {
    grid-column: 1 / -1;
  }
}
@media (max-width: 700px) {
  :where(.starter) {
    --starter-page: min(100% - 1.5rem, var(--starter-content-width, 78rem));
  }
  .starter-section {
    padding-block: clamp(2rem, 10vw, var(--starter-section-spacing, 5rem));
  }
  .starter-grid {
    gap: 1rem 0.75rem;
  }
  .starter-grid--entities {
    --starter-columns: 1 !important;
  }
  .starter-header__actions > a:not(.starter-header__cart) {
    display: none;
  }
  .starter-header__row {
    min-height: 4rem;
  }
  .starter-split {
    align-items: start;
    flex-direction: column;
  }
  .starter-footer__main {
    grid-template-columns: 1fr;
  }
  .starter-footer__newsletter {
    grid-column: auto;
  }
  .starter-footer__form {
    align-items: stretch;
    flex-direction: column;
  }
  .starter-footer__bottom {
    flex-direction: column;
  }
  .starter-footer__policies {
    justify-content: flex-start;
  }
  .starter-hero__grid,
  .starter-image-copy__grid {
    grid-template-columns: 1fr;
    min-height: 0;
  }
  .starter-hero__content {
    padding: 3.5rem 0;
  }
  .starter-hero__media,
  .starter-image-copy__media {
    min-height: min(32rem, 110vw);
  }
  .starter-image-copy__content {
    padding: 3.5rem 0;
  }
  .starter-image-copy--right .starter-image-copy__media {
    order: initial;
  }
}
@media (prefers-reduced-motion: reduce) {
  .starter-card__media img {
    transition: none;
  }
}

.starter-button { border-radius: var(--starter-button-radius, 0.25rem); }
.starter-header__icon { position: relative; display: inline-flex; align-items: center; justify-content: center; flex: 0 0 2.75rem; width: 2.75rem; height: 2.75rem; }
.starter-header__cart .starter-count { position: absolute; inset-block-start: 0; inset-inline-end: -0.3rem; font-size: 0.65rem; min-width: 1.2rem; height: 1.2rem; padding-inline: 0.25rem; }
.starter-header__brand img { width: 100%; height: auto; max-height: 3.5rem; object-fit: contain; object-position: left center; }
.starter-header__menu > summary { width: 2.75rem; list-style: none; cursor: pointer; }
.starter-header__menu > summary::-webkit-details-marker { display: none; }
.starter-header__menu[open] > summary { background: color-mix(in srgb, var(--text) 5%, var(--bg)); }
.starter-header__menu nav { max-height: min(65svh, 36rem); overflow-y: auto; }
.starter-header__menu nav a:focus-visible { outline-offset: -3px; }
.starter-header--brand-center .starter-header__brand { text-align: center; }
.starter-header--brand-center .starter-header__brand img { margin-inline: auto; object-position: center; }
@media (min-width: 901px) {
  .starter-header--drawer .starter-header__row { grid-template-columns: 2.75rem minmax(0, 1fr) auto; }
  .starter-header--drawer .starter-header__menu { display: block; position: relative; }
  .starter-header--drawer .starter-header__nav { display: none; }
  .starter-header--drawer .starter-header__menu nav { position: absolute; inset-block-start: calc(100% + 1rem); inset-inline-start: 0; display: grid; width: 20rem; padding: 0.5rem; border: 1px solid var(--border); background: var(--bg); box-shadow: var(--starter-shadow); }
  .starter-header--drawer .starter-header__menu nav a { padding: 0.75rem; text-decoration: none; }
  .starter-header--inline.starter-header--brand-center .starter-header__brand { grid-column: 2; grid-row: 1; }
  .starter-header--inline.starter-header--brand-center .starter-header__nav { grid-column: 1; grid-row: 1; justify-content: start; }
}


.starter-hero__media,
.starter-image-copy__media { min-width: 0; width: 100%; }

.starter-header--sticky {
  backdrop-filter: blur(16px);
  background: color-mix(in srgb, var(--bg) 92%, transparent);
}

.starter-nav-items,
.starter-nav-children {
  list-style: none;
  margin: 0;
  padding: 0;
}
.starter-nav-items > li,
.starter-nav-group { min-width: 0; }
.starter-nav-group > summary,
.starter-nav-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  min-height: 2.75rem;
  padding: 0.75rem;
  list-style: none;
  cursor: pointer;
  font-size: 0.875rem;
  overflow-wrap: anywhere;
}
.starter-nav-label { cursor: default; }
.starter-nav-group > summary::-webkit-details-marker { display: none; }
.starter-nav-group > summary::marker { content: ""; }
.starter-nav-chevron { width: 1rem; height: 1rem; flex: 0 0 1rem; }
.starter-nav-group[open] > summary .starter-nav-chevron { transform: rotate(180deg); }
.starter-nav-group > summary:hover,
.starter-nav-children a:hover { background: color-mix(in srgb, var(--text) 5%, var(--bg)); }
.starter-nav-group > summary:focus-visible { outline: 2px solid currentColor; outline-offset: -3px; }
.starter-nav-children { margin-inline-start: 0.75rem; border-inline-start: 1px solid var(--border); }
.starter-nav-items a { display: flex; align-items: center; min-height: 2.75rem; overflow-wrap: anywhere; }
.starter-header__menu nav .starter-nav-items { display: grid; }
.starter-header__menu nav .starter-nav-items a { padding: 0.75rem; }
.starter-header__menu nav .starter-nav-children a { padding-inline-start: 1rem; }

@media (min-width: 901px) {
  .starter-header--inline .starter-header__row { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr); }
  .starter-header__nav { min-width: 0; }
  .starter-header__nav > .starter-nav-items { display: flex; flex-wrap: wrap; align-items: center; justify-content: inherit; gap: 0.25rem 1rem; }
  .starter-header__nav > .starter-nav-items > li > a { padding-block: 0.75rem; }
  .starter-header__nav > .starter-nav-items > li > .starter-nav-group { position: relative; }
  .starter-header__nav > .starter-nav-items > li > .starter-nav-group > summary { padding-inline: 0; }
  .starter-header__nav > .starter-nav-items > li > .starter-nav-group > .starter-nav-children {
    position: absolute;
    inset-block-start: 100%;
    left: 50%;
    right: auto;
    transform: translateX(-50%);
    width: 19rem;
    max-height: min(65svh, 36rem);
    overflow-y: auto;
    margin: 0;
    padding: 0.5rem;
    border: 1px solid var(--border);
    background: var(--bg);
    box-shadow: var(--starter-shadow);
  }
  .starter-header__nav .starter-nav-children a { padding: 0.75rem; }
}
</style>
<style>
:root {
  --starter-content-width: {{ theme.settings.content_width | default: 1248 }}px;
  --starter-section-spacing: {{ theme.settings.section_spacing | default: 80 }}px;
  --starter-corner-radius: {{ theme.settings.corner_radius }}px;
  --starter-button-radius: {{ theme.settings.button_radius }}px;
  --starter-body-size: {{ theme.settings.body_size | default: 16 }}px;
}
{% if theme.settings.content_link_style == 'plain' %}
.starter-richtext a, .starter-copy a:not(.starter-button), .starter-footer__nav a, .starter-footer__policies a { text-decoration: none; }
.starter-richtext a:hover, .starter-copy a:not(.starter-button):hover, .starter-footer__nav a:hover, .starter-footer__policies a:hover { text-decoration: underline; }
{% endif %}
</style>
<header class="{% if settings.scheme != empty %}tf-scheme-{{ settings.scheme }} {% endif %}starter starter-header starter-header--{{ settings.navigation_layout }} starter-header--brand-{{ settings.brand_alignment }}{% if settings.sticky_header %} starter-header--sticky{% endif %}">
  {% if settings.show_announcement and settings.announcement_text and settings.announcement_text != empty %}
    <div class="starter-announcement">{{ settings.announcement_text }}</div>
  {% endif %}
  <div class="starter-shell starter-header__row">
    <details class="starter-header__menu">
        <summary aria-label="{{ 'menu' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
        <nav aria-label="{{ 'mobile_navigation' | t }}">
          <ul class="starter-nav-items">
            {% if settings.menu_resolved.items.size > 0 %}
              {% for nav_item_1 in settings.menu_resolved.items %}
                <li>
                  {% if nav_item_1.children.size > 0 %}
                    <details class="starter-nav-group">
                      <summary>
                        {{ nav_item_1.title }}
                        <svg class="starter-nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                      </summary>
                      <ul class="starter-nav-children">
                        {% if nav_item_1.url and nav_item_1.url != empty %}
                          <li><a href="{{ nav_item_1.url }}"{% if nav_item_1.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ 'view_all' | t }}<span class="starter-visually-hidden"> {{ nav_item_1.title }}</span></a></li>
                        {% endif %}
                        {% for nav_item_2 in nav_item_1.children %}
                          <li>
                            {% if nav_item_2.children.size > 0 %}
                              <details class="starter-nav-group">
                                <summary>
                                  {{ nav_item_2.title }}
                                  <svg class="starter-nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                                </summary>
                                <ul class="starter-nav-children">
                                  {% if nav_item_2.url and nav_item_2.url != empty %}
                                    <li><a href="{{ nav_item_2.url }}"{% if nav_item_2.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ 'view_all' | t }}<span class="starter-visually-hidden"> {{ nav_item_2.title }}</span></a></li>
                                  {% endif %}
                                  {% for nav_item_3 in nav_item_2.children %}
                                    <li>
                                      {% if nav_item_3.url and nav_item_3.url != empty %}
                                        <a href="{{ nav_item_3.url }}"{% if nav_item_3.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ nav_item_3.title }}</a>
                                      {% else %}
                                        <span class="starter-nav-label">{{ nav_item_3.title }}</span>
                                      {% endif %}
                                    </li>
                                  {% endfor %}
                                </ul>
                              </details>
                            {% else %}
                              {% if nav_item_2.url and nav_item_2.url != empty %}
                                <a href="{{ nav_item_2.url }}"{% if nav_item_2.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ nav_item_2.title }}</a>
                              {% else %}
                                <span class="starter-nav-label">{{ nav_item_2.title }}</span>
                              {% endif %}
                            {% endif %}
                          </li>
                        {% endfor %}
                      </ul>
                    </details>
                  {% else %}
                    {% if nav_item_1.url and nav_item_1.url != empty %}
                      <a href="{{ nav_item_1.url }}"{% if nav_item_1.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ nav_item_1.title }}</a>
                    {% else %}
                      <span class="starter-nav-label">{{ nav_item_1.title }}</span>
                    {% endif %}
                  {% endif %}
                </li>
              {% endfor %}
            {% else %}
              <li><a href="{{ routes.shop_url }}">{{ 'shop' | t }}</a></li>
              <li><a href="{{ routes.collections_url }}">{{ 'collections' | t }}</a></li>
            {% endif %}
          </ul>

          {%- if settings.show_search -%}
            <a href="{{ routes.search_url }}">{{ 'search' | t }}</a>
          {%- endif -%}
          {%- if settings.show_account -%}
            <a href="{{ routes.account_url }}">{{ 'account' | t }}</a>
          {%- endif %}
        </nav>
    </details>

    <a class="starter-header__brand" href="{{ routes.root_url }}">
      {% if settings.logo and settings.logo != empty %}
        <img src="{{ settings.logo | image_url: width: 480 }}" alt="{{ shop.name }}" width="{{ settings.logo_width }}" style="max-width: {{ settings.logo_width }}px" fetchpriority="high" loading="eager">
      {% else %}{{ shop.name }}{% endif %}
    </a>
    <nav class="starter-header__nav" aria-label="{{ 'main_navigation' | t }}">
      <ul class="starter-nav-items">
        {% if settings.menu_resolved.items.size > 0 %}
          {% for nav_item_1 in settings.menu_resolved.items %}
            <li>
              {% if nav_item_1.children.size > 0 %}
                <details class="starter-nav-group">
                  <summary>
                    {{ nav_item_1.title }}
                    <svg class="starter-nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                  </summary>
                  <ul class="starter-nav-children">
                    {% if nav_item_1.url and nav_item_1.url != empty %}
                      <li><a href="{{ nav_item_1.url }}"{% if nav_item_1.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ 'view_all' | t }}<span class="starter-visually-hidden"> {{ nav_item_1.title }}</span></a></li>
                    {% endif %}
                    {% for nav_item_2 in nav_item_1.children %}
                      <li>
                        {% if nav_item_2.children.size > 0 %}
                          <details class="starter-nav-group">
                            <summary>
                              {{ nav_item_2.title }}
                              <svg class="starter-nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                            </summary>
                            <ul class="starter-nav-children">
                              {% if nav_item_2.url and nav_item_2.url != empty %}
                                <li><a href="{{ nav_item_2.url }}"{% if nav_item_2.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ 'view_all' | t }}<span class="starter-visually-hidden"> {{ nav_item_2.title }}</span></a></li>
                              {% endif %}
                              {% for nav_item_3 in nav_item_2.children %}
                                <li>
                                  {% if nav_item_3.url and nav_item_3.url != empty %}
                                    <a href="{{ nav_item_3.url }}"{% if nav_item_3.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ nav_item_3.title }}</a>
                                  {% else %}
                                    <span class="starter-nav-label">{{ nav_item_3.title }}</span>
                                  {% endif %}
                                </li>
                              {% endfor %}
                            </ul>
                          </details>
                        {% else %}
                          {% if nav_item_2.url and nav_item_2.url != empty %}
                            <a href="{{ nav_item_2.url }}"{% if nav_item_2.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ nav_item_2.title }}</a>
                          {% else %}
                            <span class="starter-nav-label">{{ nav_item_2.title }}</span>
                          {% endif %}
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                </details>
              {% else %}
                {% if nav_item_1.url and nav_item_1.url != empty %}
                  <a href="{{ nav_item_1.url }}"{% if nav_item_1.open_in_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ nav_item_1.title }}</a>
                {% else %}
                  <span class="starter-nav-label">{{ nav_item_1.title }}</span>
                {% endif %}
              {% endif %}
            </li>
          {% endfor %}
        {% else %}
          <li><a href="{{ routes.shop_url }}">{{ 'shop' | t }}</a></li>
          <li><a href="{{ routes.collections_url }}">{{ 'collections' | t }}</a></li>
        {% endif %}
      </ul>

    </nav>
    <div class="starter-header__actions">
      {% if settings.show_search -%}
        <a class="starter-header__icon" href="{{ routes.search_url }}" aria-label="{{ 'search' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg></a>
      {%- endif %}
      {% if settings.show_account -%}
        <a class="starter-header__icon" href="{{ routes.account_url }}" aria-label="{{ 'account' | t }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></a>
      {%- endif %}
      <a class="starter-header__cart starter-header__icon" href="{{ routes.cart_url }}" aria-label="{{ 'cart' | t }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 7h14l1 14H4L5 7Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        {% if settings.show_cart_count and cart.item_count > 0 %}<span class="starter-count">{{ cart.item_count }}</span>{% endif %}
      </a>

    </div>
  </div>
</header>
{% schema %}
{
  "name": "starter-global-body-start",
  "kind": "section",
  "ctx_needs": [
    "shop",
    "routes",
    "cart.item_count"
  ],
  "settings": [
    {
      "id": "scheme",
      "type": "color_scheme",
      "default": "",
      "editor": {
        "label": "colorScheme",
        "group": "design"
      }
    },
    {
      "id": "menu",
      "type": "menu",
      "default": "main",
      "editor": {
        "label": "menu",
        "group": "content"
      }
    },
    {
      "id": "show_announcement",
      "type": "checkbox",
      "default": false,
      "editor": {
        "label": "showAnnouncement",
        "group": "content"
      }
    },
    {
      "id": "announcement_text",
      "type": "text",
      "default": "",
      "editor": {
        "label": "announcementText",
        "group": "content"
      }
    },
    {
      "id": "show_search",
      "type": "checkbox",
      "default": true,
      "editor": {
        "label": "showSearch",
        "group": "content"
      }
    },
    {
      "id": "show_account",
      "type": "checkbox",
      "default": true,
      "editor": {
        "label": "showAccount",
        "group": "content"
      }
    },
    {
      "id": "sticky_header",
      "type": "checkbox",
      "default": false,
      "editor": {
        "label": "stickyHeader",
        "group": "design"
      }
    },
    {
      "id": "logo",
      "type": "image",
      "default": "",
      "editor": {
        "label": "Logo",
        "group": "content"
      }
    },
    {
      "id": "logo_width",
      "type": "range",
      "default": 144,
      "editor": {
        "label": "Logo Width",
        "group": "design"
      },
      "min": 64,
      "max": 240,
      "step": 8,
      "unit": "px"
    },
    {
      "id": "navigation_layout",
      "type": "select",
      "default": "drawer",
      "editor": {
        "label": "Desktop Navigation",
        "group": "design"
      },
      "options": [
        {
          "value": "inline",
          "label": "Inline Links"
        },
        {
          "value": "drawer",
          "label": "Menu Icon"
        }
      ]
    },
    {
      "id": "brand_alignment",
      "type": "select",
      "default": "start",
      "editor": {
        "label": "Brand Alignment",
        "group": "design"
      },
      "options": [
        {
          "value": "start",
          "label": "Start"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "id": "show_cart_count",
      "type": "checkbox",
      "default": true,
      "editor": {
        "label": "Show Cart Count",
        "group": "content"
      }
    }
  ]
}
{% endschema %}
