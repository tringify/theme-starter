{
  "name": "consent-banner",
  "kind": "embed",
  "target": "global_overlay",
  "ctx_needs": [
    "consent",
    "policies",
    "design_mode",
    "csrf_token"
  ],
  "settings": [
    {
      "id": "eyebrow",
      "type": "text",
      "default": "Privacy",
      "editor": {
        "label": "eyebrow",
        "group": "content"
      }
    },
    {
      "id": "heading",
      "type": "text",
      "default": "Your privacy, your choice",
      "editor": {
        "label": "heading",
        "group": "content"
      }
    },
    {
      "id": "message",
      "type": "textarea",
      "default": "We use cookies to run the store. With your permission we also use them to measure visits and improve what we show you.",
      "editor": {
        "label": "message",
        "group": "content"
      }
    }
  ],
  "icon": "shield"
}
