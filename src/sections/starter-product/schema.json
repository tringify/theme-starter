{
  "name": "starter-product",
  "kind": "section",
  "ctx_needs": [
    "product",
    "wishlist",
    "restock_notifications",
    "reviews",
    "forms",
    "customer",
    "routes",
    "shop",
    "phone_countries",
    "customer_settings",
    "localization"
  ],
  "settings": [
    {
      "id": "gallery_layout",
      "type": "select",
      "default": "stack",
      "options": [
        {
          "value": "stack",
          "label": "stacked"
        },
        {
          "value": "grid",
          "label": "grid"
        }
      ],
      "editor": {
        "label": "galleryLayout",
        "group": "design"
      }
    },
    {
      "id": "image_fit",
      "type": "select",
      "default": "contain",
      "options": [
        {
          "value": "contain",
          "label": "showFullImage"
        },
        {
          "value": "cover",
          "label": "fillTheFrame"
        }
      ],
      "editor": {
        "label": "imageFit",
        "group": "design"
      }
    },
    {
      "id": "image_ratio",
      "type": "select",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "square"
        },
        {
          "value": "portrait",
          "label": "portrait"
        },
        {
          "value": "landscape",
          "label": "landscape"
        }
      ],
      "editor": {
        "label": "imageRatio",
        "group": "design"
      }
    }
  ],
  "blocks": {
    "default": ["title", "price", "rating", "buy_buttons", "description"],
    "types": [
      {
        "type": "title",
        "editor": {"label": "title"},
        "settings": [
          {"id": "show_vendor", "type": "checkbox", "default": true, "editor": {"label": "showVendor", "group": "content"}},
          {"id": "show_short_description", "type": "checkbox", "default": true, "editor": {"label": "showShortDescription", "group": "content"}}
        ]
      },
      {
        "type": "price",
        "editor": {"label": "price"},
        "settings": [
          {"id": "show_tax_note", "type": "checkbox", "default": true, "editor": {"label": "showTaxNote", "group": "content"}}
        ]
      },
      {
        "type": "rating",
        "editor": {"label": "rating"},
        "settings": [
          {"id": "show_review_count", "type": "checkbox", "default": true, "editor": {"label": "showReviewCount", "group": "content"}}
        ]
      },
      {
        "type": "buy_buttons",
        "editor": {"label": "buyButtons"},
        "settings": [
          {"id": "show_buy_now", "type": "checkbox", "default": true, "editor": {"label": "showBuyNow", "group": "content"}},
          {"id": "show_wishlist", "type": "checkbox", "default": true, "editor": {"label": "showWishlist", "group": "content"}}
        ]
      },
      {
        "type": "description",
        "editor": {"label": "description"},
        "settings": [
          {"id": "open", "type": "checkbox", "default": true, "editor": {"label": "openByDefault", "group": "content"}}
        ]
      }
    ],
    "accept_app_blocks": true
  }
}
