<h2 class="starter-heading starter-heading--{{ settings.size }}">{{ settings.text }}</h2>
{% schema %}
{
  "name": "starter-heading",
  "kind": "block",
  "settings": [
    {
      "id": "text",
      "type": "text",
      "default": "Make room for the everyday.",
      "editor": {
        "label": "heading",
        "group": "content"
      }
    },
    {
      "id": "size",
      "type": "select",
      "default": "medium",
      "editor": {
        "label": "headingSize",
        "group": "design"
      },
      "options": [
        {
          "value": "small",
          "label": "small"
        },
        {
          "value": "medium",
          "label": "medium"
        },
        {
          "value": "large",
          "label": "large"
        }
      ]
    }
  ]
}
{% endschema %}
