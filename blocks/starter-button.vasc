{% if settings.label and settings.label != empty and settings.url and settings.url != empty %}<a class="starter-button{% if settings.style == 'outline' %} starter-button--secondary{% endif %}" href="{{ settings.url }}">{{ settings.label }}</a>{% endif %}
{% schema %}
{
  "name": "starter-button",
  "kind": "block",
  "settings": [
    {
      "id": "label",
      "type": "text",
      "default": "Explore the Collection",
      "editor": {
        "label": "buttonLabel",
        "group": "content"
      }
    },
    {
      "id": "url",
      "type": "url",
      "default": "",
      "editor": {
        "label": "buttonLink",
        "group": "content"
      }
    },
    {
      "id": "style",
      "type": "select",
      "default": "solid",
      "editor": {
        "label": "buttonStyle",
        "group": "design"
      },
      "options": [
        {
          "value": "solid",
          "label": "solid"
        },
        {
          "value": "outline",
          "label": "outline"
        }
      ]
    }
  ]
}
{% endschema %}
